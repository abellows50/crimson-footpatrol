# Copy to settings.env and fill in what you want. Everything is optional.

# Phone push via the free ntfy app (iOS/Android): subscribe to this topic in the app.
# Anyone who knows the topic name can read it, so make it long and random.
# NTFY_TOPIC=crimson-ems-dispatch-CHANGE-ME-8f3k2

# GroupMe: create a bot at https://dev.groupme.com/bots for your crew chat and paste its bot ID.
# GROUPME_BOT_ID=

# Any Slack/Discord-style incoming webhook (receives JSON {"text": ...}).
# WEBHOOK_URL=

# Push "medium" (possible) alerts to phones too? Default is high only.
# PUSH_LEVEL=high

# Link included in push notifications (the dashboard address crews can open).
# PUBLIC_URL=http://192.168.1.20:8080

# Required to edit keywords / send test pushes from the dashboard.
# ADMIN_KEY=pick-a-password

# Whisper model. Default: models/large-v3-turbo-mlx on Apple Silicon (install.command downloads it), else small.en.
# WHISPER_MODEL=small.en

# Use OpenAI's API for transcription instead of running Whisper on this computer.
# OPENAI_API_KEY=

# PORT=8080

# Reach OpenMHz through the real Google Chrome (needed for its Cloudflare check); install.command sets these.
# BROWSER_CHANNEL=chrome
# HEADFUL=1
